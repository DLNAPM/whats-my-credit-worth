{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "User profile with financial data and settings",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "description": "User's email address"
        },
        "displayName": {
          "type": "string",
          "description": "User's display name"
        },
        "isPremium": {
          "type": "boolean",
          "description": "Whether the user is a premium user"
        },
        "isAdmin": {
          "type": "boolean",
          "description": "Whether the user is an admin"
        },
        "isFrozen": {
          "type": "boolean",
          "description": "Whether the user account is frozen"
        },
        "createdAt": {
          "type": "string",
          "description": "Account creation timestamp"
        },
        "lastLogin": {
          "type": "string",
          "description": "Last login timestamp"
        }
      },
      "required": ["email"]
    },
    "SupportRequest": {
      "title": "Support Request",
      "description": "Support request or feedback submitted by a user",
      "type": "object",
      "properties": {
        "to": {
          "type": "string",
          "description": "Destination support email address"
        },
        "message": {
          "type": "object",
          "description": "Detailed email message"
        },
        "userId": {
          "type": "string",
          "description": "The ID of the user submitting the request"
        },
        "createdAt": {
          "type": "string",
          "description": "Timestamp of creation"
        },
        "status": {
          "type": "object",
          "description": "Status of the request"
        }
      },
      "required": ["to", "message", "userId", "createdAt"]
    },
    "SharedSnapshot": {
      "title": "Shared Snapshot",
      "description": "A financial snapshot shared publicly",
      "type": "object",
      "properties": {
        "monthYear": {
          "type": "string",
          "description": "The month and year for the snapshot"
        },
        "data": {
          "type": "object",
          "description": "The complete financial data structure for the month"
        },
        "createdAt": {
          "type": "string",
          "description": "Timestamp of snapshot creation"
        },
        "summary": {
          "type": "object",
          "description": "Summary containing net worth and monthly income"
        }
      },
      "required": ["monthYear", "data", "createdAt"]
    },
    "SystemIncident": {
      "title": "System Incident",
      "description": "App alert or incident caused by API restrictions, billing, or integrations",
      "type": "object",
      "properties": {
        "title": { "type": "string", "description": "Title of the incident" },
        "category": { "type": "string", "description": "Incident category" },
        "severity": { "type": "string", "description": "Severity level" },
        "status": { "type": "string", "description": "Incident status (open, acknowledged, resolved)" },
        "message": { "type": "string", "description": "Incident details and error summary" },
        "errorDetails": { "type": "string", "description": "Detailed error message or stack" },
        "source": { "type": "string", "description": "Originating component or service" },
        "userEmail": { "type": "string", "description": "User email context if available" },
        "userId": { "type": "string", "description": "User UID context if available" },
        "occurredAt": { "type": "string", "description": "ISO timestamp of incident" },
        "acknowledgedAt": { "type": "string", "description": "ISO timestamp of acknowledgment" },
        "acknowledgedBy": { "type": "string", "description": "Admin email who acknowledged" },
        "resolvedAt": { "type": "string", "description": "ISO timestamp of resolution" },
        "resolvedBy": { "type": "string", "description": "Admin email who resolved" },
        "emailSent": { "type": "boolean", "description": "Whether an alert email was dispatched" },
        "emailRecipient": { "type": "string", "description": "Admin email recipient" },
        "occurrenceCount": { "type": "number", "description": "Number of occurrences" }
      },
      "required": ["title", "category", "severity", "status", "message", "occurredAt"]
    },
    "MailMessage": {
      "title": "Mail Message",
      "description": "Email queue documents processed by Firebase Trigger Email extension",
      "type": "object",
      "properties": {
        "to": { "type": "string", "description": "Recipient email or array of recipients" },
        "message": { "type": "object", "description": "Email subject, text, and html content" },
        "createdAt": { "type": "string", "description": "Timestamp when queued" },
        "delivery": { "type": "object", "description": "Delivery status populated by Trigger Email extension" }
      },
      "required": ["to", "message"]
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": "User",
      "description": "User documents mapping to their unique user ID"
    },
    "support_requests/{requestId}": {
      "schema": "SupportRequest",
      "description": "Support request messages for admin and automated email routing"
    },
    "mail/{mailId}": {
      "schema": "MailMessage",
      "description": "Email queue documents for Firebase Trigger Email extension"
    },
    "shared_snapshots/{snapshotId}": {
      "schema": "SharedSnapshot",
      "description": "Publicly shared snapshots generated by users"
    },
    "system_incidents/{incidentId}": {
      "schema": "SystemIncident",
      "description": "System alarms, error incidents, and alerts for admin acknowledgment"
    }
  }
}
